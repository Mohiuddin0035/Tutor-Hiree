// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("PARENT") // TUTOR, PARENT, ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  tuitionJobs   TuitionJob[] @relation("ParentJobs")
  appliedJobs   TuitionJob[] @relation("TutorJobs")
  reviews       Review[]     @relation("ReviewAuthor")
  receivedReviews Review[]   @relation("ReviewTarget")
  progressUpdates   ProgressUpdate[] @relation("TutorUpdates")
  receivedUpdates   ProgressUpdate[] @relation("GuardianUpdates")
  assignedHomeworks  Homework[]       @relation("TutorHomeworks")
  guardianComments  GuardianComment[]
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tutorSeq            Int      @unique @default(autoincrement())
  phone               String?
  address             String?
  bio                 String?
  education           String?
  pendingBio          String?
  pendingEducation    String?
  verificationStatus  String   @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  nidImageUrl         String?
  universityIdImageUrl String?
  selfieImageUrl       String?
  gender              String?  // Male, Female, Other
  preferable_time     String?
  is_active           Boolean  @default(true)
  reactivationRequested Boolean  @default(false)
  studentClass        String?  // The class/grade the parent needs a tutor for
  hoursRequired       String?  // Expected time commitment
  tutorGenderPreference String? // Parent's preference for tutor gender
  salary              String?  // Expected salary offered by parent
  numberOfChildren    String?  // How many children the parent needs tutoring for
  latitude            Float?   // Exact location
  longitude           Float?   // Exact location
  approxLatitude      Float?   // Blurred location for public
  approxLongitude     Float?   // Blurred location for public
  rejectionReason     String?
  rejectedAt          DateTime?
  actualLatitude      Float?
  actualLongitude     Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model TuitionJob {
  id              String   @id @default(cuid())
  jobSeq          Int      @unique @default(autoincrement())
  title           String
  description     String
  subject         String
  classLevel      String
  salary          Int
  parentId        String
  parent          User     @relation("ParentJobs", fields: [parentId], references: [id], onDelete: Cascade)
  tutorId         String?
  tutor           User?    @relation("TutorJobs", fields: [tutorId], references: [id])
  status          String   @default("OPEN") // OPEN, ASSIGNED, COMPLETED, CANCELLED
  latitude        Float?   // Exact location
  longitude       Float?   // Exact location
  approxLatitude  Float?   // Blurred location for public
  approxLongitude Float?   // Blurred location for public
  locationUnlocked Boolean  @default(false)
  tutorDetailsReleased Boolean @default(false)
  commissionPaid  Boolean  @default(false) // Whether the 10% commission has been paid by tutor
  commissionAmount Int?    // Calculated commission amount (salary × 10%)
  tutorRequirement String?  // Specific dept students/public/private varsity requirements
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments        Payment[]
  progressUpdates ProgressUpdate[]
  homeworks       Homework[]
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id                String    @id @default(cuid())
  amount            Int
  status            String    @default("PENDING") // PENDING, SUCCESS, FAILED
  type              String    // UNLOCK_FEE, SALARY_COMMISSION, COMMISSION_FEE
  trxId             String?   @unique
  jobId             String
  job               TuitionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tutorId           String?
  payerRole         String?   // Always "TUTOR" in the commission model
  refundRequestedAt DateTime? // When the tutor requested a refund
  refundStatus      String?   // REQUESTED, APPROVED, REJECTED
  refundReason      String?   // Reason for refund request
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Blacklist {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  email     String?
  role      String?
  reason    String?
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ProgressUpdate {
  id             String    @id @default(cuid())
  jobId          String
  job            TuitionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tutorId        String
  tutor          User      @relation("TutorUpdates", fields: [tutorId], references: [id], onDelete: Cascade)
  guardianId     String
  guardian       User      @relation("GuardianUpdates", fields: [guardianId], references: [id], onDelete: Cascade)
  type           String    // CLASS_NOTE, HOMEWORK, EXAM, ATTENDANCE, GENERAL
  title          String
  description    String
  sessionDate    DateTime
  rating         Int?      // 1-5 performance rating
  attachmentUrls String[]  // URLs of uploaded files
  seen           Boolean   @default(false)
  seenAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  comments       GuardianComment[]
  homeworks      Homework[]
}

model Homework {
  id                String    @id @default(cuid())
  jobId             String
  job               TuitionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tutorId           String
  tutor             User      @relation("TutorHomeworks", fields: [tutorId], references: [id], onDelete: Cascade)
  progressUpdateId  String?
  progressUpdate    ProgressUpdate? @relation(fields: [progressUpdateId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  subject           String
  assignedDate      DateTime  @default(now())
  dueDate           DateTime
  status            String    @default("ASSIGNED") // ASSIGNED, COMPLETED, OVERDUE, CANCELLED
  completedAt       DateTime?
  tutorRemarks      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model GuardianComment {
  id                String    @id @default(cuid())
  progressUpdateId  String
  progressUpdate    ProgressUpdate @relation(fields: [progressUpdateId], references: [id], onDelete: Cascade)
  guardianId        String
  guardian          User      @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  comment           String
  createdAt         DateTime  @default(now())
}
